{
  "name": "personal-assistant",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=@pa/backend",
    "dev:all": "turbo run dev --filter=@pa/backend --filter=@pa/mobile",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "import:receipts": "node packages/backend/scripts/importReceipts.ts"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.4"
  },
  "version": "1.0.0"
}
