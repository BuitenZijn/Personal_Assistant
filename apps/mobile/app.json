{
  "expo": {
    "name": "Personal Assistant",
    "slug": "personal-assistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "personalassistant",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.personalassistant.shop",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.personalassistant.shop",
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "allowBackup": false
    },
    "web": {},
    "plugins": [
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1EEDB"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Personal Assistant lets you choose a photo for your profile.",
          "cameraPermission": "Personal Assistant lets you take a photo for your profile.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
