# Copy to .env (git-ignored). Read by apps/mobile (app.config.ts).
# `npx convex dev` in packages/backend writes its own packages/backend/.env.local.
CONVEX_DEPLOYMENT=dev:youthful-finch-562
CONVEX_URL=https://youthful-finch-562.eu-west-1.convex.cloud

# Set on the Convex deployment (npx convex env set ...), not here:
#   JWT_PRIVATE_KEY, JWKS    node packages/backend/scripts/generateKeys.mjs
#   AUTH_RESEND_KEY          Resend API key
#   EMAIL_FROM               optional, e.g. Personal Assistant <noreply@buitenzijnvzw.be>
